{
  "name": "shared",
  "description": "Typescript shared function package",
  "version": "0.0.0",
  "private": true,
  "homepage": "https://github.com/openmcp-project/blueprint-workflows",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openmcp-project/blueprint-workflows"
  },
  "bugs": {
    "url": "https://github.com/openmcp-project/blueprint-workflows/issues"
  },
  "keywords": [
    "actions",
    "node",
    "setup"
  ],
  "engines": {
    "node": ">=21"
  },
  "scripts": {
    "bundle": "npm run format:write && npm run package",
    "ci-test": "npx jest",
    "coverage": "npx make-coverage-badge --output-path ./badges/coverage.svg",
    "format:write": "npx prettier --write ./src ./__test__",
    "format:check": "npx prettier --check ./src ./__test__",
    "lint": "npx eslint . -c ../../../../.github/linters/.eslintrc.yml --resolve-plugins-relative-to path::./",
    "local-action": "npx local-action . src/main.ts .env",
    "package": "npx ncc build src/index.ts -o dist --source-map --license licenses.txt",
    "package:watch": "npm run package -- --watch",
    "test": "npx jest",
    "all": "npm run format:write && npm run lint && npm run test && npm run coverage && npm run package"
  },
  "license": "Apache-2.0",
  "jest": {
    "preset": "ts-jest",
    "verbose": true,
    "clearMocks": true,
    "testEnvironment": "node",
    "moduleFileExtensions": [
      "js",
      "ts"
    ],
    "testMatch": [
      "**/*.test.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ],
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "coverageReporters": [
      "json-summary",
      "text",
      "lcov"
    ],
    "collectCoverage": true,
    "collectCoverageFrom": [
      "./src/**"
    ]
  },
  "dependencies": {
    "@actions/core": "^2.0.0",
    "helm-ts": "^0.1.5",
    "js-yaml": "^4.1.0",
    "loglevel": "^1.9.2",
    "node-helm": "^0.1.0",
    "semver": "^7.6.3",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@github/local-action": "7.0.1",
    "@jest/globals": "30.4.1",
    "@types/jest": "30.0.0",
    "@types/js-yaml": "4.0.9",
    "@types/node": "24.13.3",
    "@types/semver": "7.8.0",
    "@typescript-eslint/eslint-plugin": "8.68.0",
    "@typescript-eslint/parser": "8.68.0",
    "@vercel/ncc": "0.45.0",
    "eslint": "10.9.1",
    "eslint-plugin-jest": "29.16.6",
    "eslint-plugin-jsonc": "3.4.2",
    "eslint-plugin-prettier": "5.5.6",
    "jest": "30.4.2",
    "make-coverage-badge": "1.2.0",
    "prettier": "3.9.6",
    "prettier-eslint": "17.1.2",
    "ts-jest": "29.4.12",
    "typescript": "6.0.3"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts"
}
